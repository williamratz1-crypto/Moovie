# Copy this file to `web/.env` and fill in the values below.
#
# Vite inlines every VITE_* variable into the client bundle at build time, so
# anything here is PUBLIC. Never put a secret (an OpenAI key, a service account,
# a TMDB write token) in this file.
#
# `npm run dev` and `npm run build` both read this file.

# ---------------------------------------------------------------------------
# TMDB — required. The app is useless without it.
# Create a Read Access Token at https://www.themoviedb.org/settings/api and
# paste it here (this is the long JWT-style token, not the 32-char API key).
# ---------------------------------------------------------------------------
VITE_TMDB_READ_TOKEN=your_tmdb_read_access_token_here

# ---------------------------------------------------------------------------
# Firebase — required for sign-in and cloud sync (watchlist, ratings, account).
# Copy the values from your Firebase project's web app config:
# Firebase console > Project settings > General > Your apps > SDK setup.
#
# Leave these blank and the app will render a "Firebase isn't configured"
# notice instead of the UI (it will NOT crash — see web/src/firebase.js).
#
# Also add every domain you deploy to under
# Firebase console > Authentication > Settings > Authorized domains,
# otherwise Google sign-in fails with `auth/unauthorized-domain`.
# ---------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
